# Legacy Docker builder compatible: no BuildKit mounts or Dockerfile heredocs.
# Build from an empty context with a publicly readable MOLSTEER_URL:
#   docker build -t molsteer:standalone-cu121 - < Dockerfile.standalone
# H-Dw/MolSteer currently requires authentication. Supply an anonymously
# readable mirror with --build-arg MOLSTEER_URL=... on legacy builders, or use
# Dockerfile.buildkit with a short-lived secret on a BuildKit-enabled host.
FROM nvcr.io/nvidia/cuda:12.1.1-runtime-ubuntu22.04
USER root

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG MINICONDA_INSTALLER=Miniconda3-py312_25.3.1-1-Linux-x86_64.sh
ARG MINICONDA_SHA256=8937a2c9a86cfc5495ba2234476f89686beff5c8e0569b1ed5771a927c75107b
ARG MOLSTEER_URL=https://github.com/H-Dw/MolSteer.git
ARG MOLSTEER_REF=f2951d7fb35f50b3838325200b2baf5dcc9c152c
ARG FLOWR_URL=https://github.com/jule-c/flowr_root.git
ARG FLOWR_REF=c545b14293d978706a36ab77218cf3cb55e8b6f5

ENV DEBIAN_FRONTEND=noninteractive \
    CONDA_DIR=/opt/conda \
    MOLSTEER_ROOT=/opt/MolSteer \
    FLOWR_ROOT=/opt/MolSteer/flowr_root \
    PYTHONPATH=/opt/MolSteer/flowr_root \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# The CUDA runtime image and pinned PyTorch cu121 wheel supply the GPU user
# libraries. Python dependencies come from MolSteer's environment.yml.
# Some managed legacy builders unpack the image's APT keyrings so _apt
# cannot read them. Restore readable modes, keep signature checks enabled,
# and avoid the base image's cache-clean hook, which also fails there.
RUN chmod 0755 /etc/apt /etc/apt/trusted.gpg.d /usr/share/keyrings \
    && chmod 0644 /etc/apt/trusted.gpg.d/*.gpg \
                  /usr/share/keyrings/cuda-archive-keyring.gpg \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get -o APT::Sandbox::User=root update \
    && apt-get -o APT::Sandbox::User=root install -y --no-install-recommends \
        bash ca-certificates curl git openssh-server openssh-client sudo tini \
        libgl1 libglib2.0-0 libgomp1 libsm6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/ssh/ssh_host_* \
    && useradd --create-home --shell /bin/bash --uid 1000 molsteer \
    && usermod -aG sudo molsteer \
    && printf '%s\n' 'molsteer ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/molsteer \
    && chmod 0440 /etc/sudoers.d/molsteer \
    && printf '%s\n' \
        'PermitRootLogin no' \
        'PasswordAuthentication no' \
        'KbdInteractiveAuthentication no' \
        'PubkeyAuthentication yes' \
        'AllowUsers molsteer' \
        'SetEnv PATH=/opt/conda/envs/molsteer-flowr/bin:/opt/conda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin MOLSTEER_ROOT=/opt/MolSteer FLOWR_ROOT=/opt/MolSteer/flowr_root PYTHONPATH=/opt/MolSteer/flowr_root' \
        > /etc/ssh/sshd_config.d/90-molsteer.conf \
    && install -d -m 0700 -o molsteer -g molsteer /home/molsteer/.ssh

RUN curl -fsSL "https://repo.anaconda.com/miniconda/${MINICONDA_INSTALLER}" \
        -o /tmp/miniconda.sh \
    && echo "${MINICONDA_SHA256}  /tmp/miniconda.sh" | sha256sum -c - \
    && bash /tmp/miniconda.sh -b -p /opt/conda \
    && rm /tmp/miniconda.sh \
    && /opt/conda/bin/conda clean -afy

ENV PATH=/opt/conda/bin:${PATH}

# Source checkout is pinned so upstream changes cannot silently alter the
# generator or MolSteer. This variant only accepts anonymous Git access.
RUN set -euo pipefail; \
    GIT_TERMINAL_PROMPT=0 git clone --quiet "${MOLSTEER_URL}" "${MOLSTEER_ROOT}"; \
    git -C "${MOLSTEER_ROOT}" checkout --quiet --detach "${MOLSTEER_REF}"; \
    test "$(git -C "${MOLSTEER_ROOT}" rev-parse HEAD)" = "${MOLSTEER_REF}"; \
    GIT_TERMINAL_PROMPT=0 git clone --quiet "${FLOWR_URL}" "${FLOWR_ROOT}"; \
    git -C "${FLOWR_ROOT}" checkout --quiet --detach "${FLOWR_REF}"; \
    test "$(git -C "${FLOWR_ROOT}" rev-parse HEAD)" = "${FLOWR_REF}"; \
    test -f "${FLOWR_ROOT}/flowr/__init__.py"

# FLOWR's upstream pyproject/uv.lock targets PyTorch 2.11 and CUDA 13.
# Install the previously validated CUDA 12.1 dependency set instead, and
# expose the pinned FLOWR source through PYTHONPATH without installing its
# incompatible package metadata.
RUN /opt/conda/bin/conda env create -f "${MOLSTEER_ROOT}/environment.yml" \
    && /opt/conda/bin/conda clean -afy

ENV PATH=/opt/conda/envs/molsteer-flowr/bin:/opt/conda/bin:${PATH}
WORKDIR /opt/MolSteer

RUN python -m pip install --no-deps -e /opt/MolSteer \
    && python -m pip check \
    && python -c 'import flowr.gen.generate_from_pdb; import molsteer, langchain_core, torch; assert torch.__version__.startswith("2.5.1"); assert torch.version.cuda == "12.1"' \
    && chown -R molsteer:molsteer /opt/MolSteer

# Host keys are generated on container startup. Mount a public key at
# /run/secrets/ssh_authorized_keys to enable SSH login; passwords are disabled.
EXPOSE 22
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/bash", "-lc", "set -e; install -d -m 0755 /run/sshd; ssh-keygen -A >/dev/null; if [ -f /run/secrets/ssh_authorized_keys ]; then install -d -m 0700 -o molsteer -g molsteer /home/molsteer/.ssh; install -m 0600 -o molsteer -g molsteer /run/secrets/ssh_authorized_keys /home/molsteer/.ssh/authorized_keys; fi; exec /usr/sbin/sshd -D -e"]
