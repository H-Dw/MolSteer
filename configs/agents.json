{
  "providers": {
    "openrouter": {
      "kind": "openrouter",
      "api_key_env": "OPENROUTER_API_KEY",
      "api_key_secret": "openrouter_api_key",
      "base_url": "https://openrouter.ai/api/v1"
    },
    "openai": {
      "kind": "openai",
      "api_key_env": "OPENAI_API_KEY",
      "api_key_secret": "openai_api_key",
      "base_url": null
    },
    "anthropic": {
      "kind": "anthropic",
      "api_key_env": "ANTHROPIC_API_KEY",
      "api_key_secret": "anthropic_api_key",
      "base_url": null
    }
  },
  "models": {
    "default": {
      "provider": "openrouter",
      "model": "z-ai/glm-5.3",
      "temperature": null,
      "max_tokens": 32768,
      "timeout": 300.0,
      "max_retries": 2,
      "reasoning_enabled": true,
      "reasoning_effort": "low",
      "api_transport": "openai_compatible",
      "require_parameters": true
    },
    "mathematics": {
      "provider": "openrouter",
      "model": "z-ai/glm-5.3",
      "temperature": null,
      "max_tokens": 16384,
      "timeout": 300.0,
      "max_retries": 2,
      "reasoning_enabled": true,
      "reasoning_effort": "low",
      "api_transport": "openai_compatible",
      "require_parameters": true,
      "streaming": true
    }
  },
  "agents": {
    "molreader": {
      "model": "default",
      "description": "Evidence and context reader"
    },
    "molthinker": {
      "model": "default",
      "description": "Conflict-aware reasoning and planning"
    },
    "molexecutor": {
      "model": "default",
      "description": "Execution proposal agent"
    },
    "molmonitor": {
      "model": "default",
      "description": "Monitoring and retuning agent"
    }
  },
  "reader": {
    "raw_reference": {
      "enabled": false,
      "manifest_path": null,
      "reference_times": [],
      "include_final": true,
      "views": ["prediction", "state"],
      "factors": [],
      "cross_view_associations": false,
      "group_regional_candidates": true,
      "analyses": ["persistent_defects", "late_repair", "beneficial_regions"],
      "outcome_metrics": [
        {"metric_id": "affinity", "value_path": ["pkd"], "view": "prediction", "direction": "higher"},
        {"metric_id": "sa_score", "value_path": ["sa_score"], "view": "prediction", "direction": "lower"},
        {"metric_id": "mmff_strain", "value_path": ["strain_proxy_kcal_mol"], "view": "prediction", "direction": "lower"}
      ]
    }
  },
  "thinker": {
    "architecture": "dual_expert",
    "experts": {
      "mathematics": "mathematics"
    },
    "max_discussions": 2,
    "max_research_requests": 4,
    "research_max_steps": 6,
    "research_max_searches": 3,
    "research_result_limit": 5,
    "external_research": true,
    "require_design_audit": true
  },
  "runtime": {
    "max_agent_steps": 24,
    "max_repairs": 8,
    "max_replans": 2,
    "max_segments": 20,
    "skill": "skills/molthinker-reward-creativity/SKILL.md",
    "trace_dir": "outputs/agent_runs",
    "secrets_file": "configs/secrets.local.json",
    "langsmith_tracing": false
  },
  "monitoring": {
    "graph_review_enabled": false,
    "window": 8,
    "warmup": 4,
    "threshold": 4.5,
    "persistence": 2,
    "recovery": 3,
    "cooldown": 2,
    "max_retunes": 2,
    "decay": 0.5,
    "min_strength": 0.01,
    "max_strength": 1.0
  },
  "mode": "api"
}
