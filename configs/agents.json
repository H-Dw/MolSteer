{
  "providers": {
    "openai": {
      "kind": "openai",
      "api_key_env": "OPENAI_API_KEY",
      "api_key_secret": "openai_api_key",
      "base_url": null
    },
    "anthropic": {
      "kind": "anthropic",
      "api_key_env": "ANTHROPIC_API_KEY",
      "api_key_secret": "anthropic_api_key",
      "base_url": null
    }
  },
  "models": {
    "default": {
      "provider": "openai",
      "model": "REPLACE_WITH_MODEL_ID",
      "temperature": null,
      "max_tokens": 4096,
      "timeout": 120.0,
      "max_retries": 2
    }
  },
  "agents": {
    "molreader": {"model": "default", "description": "Evidence and context reader"},
    "molthinker": {"model": "default", "description": "Conflict-aware reasoning and planning"},
    "molexecutor": {"model": "default", "description": "Execution proposal agent"},
    "molmonitor": {"model": "default", "description": "Monitoring and retuning agent"}
  },
  "runtime": {
    "max_agent_steps": 12,
    "max_repairs": 2,
    "max_replans": 2,
    "max_segments": 20,
    "skill": "skills/molthinker-conflict-aware-control/SKILL.md",
    "trace_dir": "outputs/agent_runs",
    "secrets_file": "configs/secrets.local.json",
    "langsmith_tracing": false
  },
  "monitoring": {
    "window": 8,
    "warmup": 4,
    "threshold": 4.5,
    "persistence": 2,
    "recovery": 3,
    "cooldown": 2,
    "max_retunes": 2,
    "decay": 0.5,
    "min_strength": 0.01,
    "max_strength": 1.0
  },
  "mode": "api"
}
